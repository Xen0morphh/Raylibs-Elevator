CC = gcc
CFLAGS = -Wall -Wextra -std=c99

# Beritahu kompilator untuk mencari header di folder "header" dan folder root "."
INCLUDES = -I./header -I.

# Library KHUSUS WINDOWS (Sangat penting agar tidak error saat compile)
LIBS = -lraylib -lopengl32 -lgdi32 -lwinmm -lm

# Daftar semua file .c Anda (Sudah ditambahkan BuildingView, MechView, dan UI)
SRCS = Main.c src/About.c src/BuildingView.c src/Camera.c src/Guide.c src/Lift.c src/MechView.c src/Menu.c src/Simulation.c src/Transformasi.c src/UI.c src/Person.c
TARGET = simulasi_lift.exe

build:
	$(CC) $(CFLAGS) $(INCLUDES) $(SRCS) -o $(TARGET) $(LIBS)

clean:
	del $(TARGET)

# Cara pakai di Windows:
# 1. Buka terminal 
# 2. Ketik: mingw32-make -f Makefile.win
# 3. Jalankan aplikasi: .exe
# 4. Hapus aplikasi: make clean